# COANTO backend / persistence / authentication
INSFORGE_URL=
INSFORGE_API_KEY=

# Search providers (at least one recommended for production discovery)
BRAVE_SEARCH_API_KEY=
BING_SEARCH_V7_KEY=

# Optional Apify acquisition fallback for difficult public pages.
# fallback = direct HTTP first, then Apify; preferred = Apify first; off = never use Apify.
# Token is server-only and is sent to Apify in the Authorization header, never in URLs.
APIFY_TOKEN=
APIFY_MODE=fallback
APIFY_ACTOR_ID=apify/website-content-crawler
APIFY_TIMEOUT_SECONDS=60

# Scheduled monitoring
CRON_SECRET=

# Independent AI providers
# AI_PROVIDER selects the preferred provider; configured fallbacks may be used by server logic.
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5

# Optional public site identifier used by provider integrations
COANTO_SITE_URL=https://coanto.com
