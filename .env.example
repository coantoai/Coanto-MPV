# COANTO release identity / public origin
# validation = invite/beta launch without paid checkout; commercial = paid public launch.
COANTO_LAUNCH_MODE=validation
COANTO_SITE_URL=https://coanto.com
# Set by the deployment platform to the deployed commit SHA when available.
COANTO_RELEASE_SHA=

# COANTO backend / persistence / authentication (server-only)
INSFORGE_URL=
INSFORGE_API_KEY=
# Independent HMAC key for auth-throttle identifiers. Use >=32 random characters.
# Do not reuse an API key in production.
AUTH_RATE_LIMIT_SECRET=

# Primary competitor discovery uses Gemini + Google Search grounding.
# Brave/Bing are optional legacy fallbacks and are not required when Gemini is configured.
BRAVE_SEARCH_API_KEY=
BING_SEARCH_V7_KEY=

# Optional Apify acquisition fallback for difficult public pages.
# fallback = direct HTTP first, then Apify; preferred = Apify first; off = never use Apify.
# Token is server-only and is sent to Apify in the Authorization header, never in URLs.
APIFY_TOKEN=
APIFY_MODE=fallback
APIFY_ACTOR_ID=apify/website-content-crawler
APIFY_TIMEOUT_SECONDS=60

# Scheduled monitoring. Use >=32 random characters in production.
CRON_SECRET=

# Analysis performance / cost controls (server-only)
# Cache identical successful analyses briefly, block duplicate concurrent runs,
# and protect provider spend with per-account burst/daily budgets.
COANTO_ANALYSIS_CACHE_SECONDS=600
COANTO_ANALYSIS_BURST_LIMIT=4
COANTO_ANALYSIS_DAILY_LIMIT=40
COANTO_AI_PROMPT_MAX_CHARS=60000
COANTO_AI_MAX_OUTPUT_TOKENS=6000
COANTO_AI_WEB_SEARCH_MAX_USES=6

# Independent AI providers
# AI_PROVIDER selects the preferred provider; at least one configured provider is required.
AI_PROVIDER=gemini

GEMINI_API_KEY=
# Flash-Lite is the economical default. COANTO does not combine its Google Search tool
# with structured-output schema on this model because that legacy API combination is unsupported.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_DISCOVERY_MODEL=gemini-3.1-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5

# Billing remains provider-neutral. Validation launch does not expose fake checkout.
# Commercial launch remains blocked until a real signed provider adapter is implemented
# and the launch-readiness policy is updated by code review.
